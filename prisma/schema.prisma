generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ——— Better Auth models (shape required by better-auth's prisma adapter) ———
// Copied from Journal (Better Auth 1.7.3: no `account.issuer`), per SPEC.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  cards         Card[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

// ——— App models (SPEC-cards.md "Entities & schema") ———

enum BarcodeFormat {
  CODE128
  EAN13
  EAN8
  UPCA
  QR
}

enum CardColor {
  RED
  ORANGE
  YELLOW
  GREEN
  TEAL
  BLUE
  INDIGO
  PURPLE
  PINK
  SLATE
}

model Card {
  id         String        @id @default(uuid())
  /// Trimmed, 1–60 chars (validated in the shared Zod schema).
  storeName  String
  /// Trimmed, 1–200 chars. Deliberately NOT unique — duplicates are a soft
  /// rule handled in the service (SPEC rule 6).
  code       String
  format     BarcodeFormat
  /// null → the default (slate) tile.
  color      CardColor?
  /// Set when show mode opens; null = never shown. Drives wallet order (rule 4).
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, lastUsedAt(sort: Desc)])
  @@map("card")
}
